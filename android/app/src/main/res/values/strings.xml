<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Tiktok Mobile</string>

    <!-- ─── Facebook Login ─────────────────────────────────────────────
         facebook_app_id      : developers.facebook.com → Cài đặt → Cơ bản → ID ứng dụng
         facebook_client_token: Cài đặt ứng dụng → Nâng cao → Mã khách hàng (Client token)
         fb_login_protocol_scheme = "fb" + facebook_app_id

         KHÔNG đặt App Secret vào file này. Secret chỉ nằm ở backend .env.
         Nhớ đăng ký key hash Android trong Console, nếu không login fail im lặng:
           keytool -exportcert -alias androiddebugkey -keystore ~/.android/debug.keystore \
             -storepass android | openssl sha1 -binary | openssl base64
    -->
    <string name="facebook_app_id">1020146147503519</string>
    <string name="facebook_client_token">e7db5738df65b0d004967d14b7201384</string>
    <string name="fb_login_protocol_scheme">fb1020146147503519</string>

    <!-- ─── Google Sign-In ─────────────────────────────────────────────
         Android KHÔNG cần Android client ID trong code - Google khớp bằng
         package name (com.tiktokclone.mobile) + SHA-1 lúc chạy.
         Chỉ cần Web client ID, truyền vào serverClientId để nhận idToken.
         Thiếu nó thì idToken = null.
    -->
    <string name="google_server_client_id">581480201411-pr5o1eeld820c30u2enb3nonbk68fihm.apps.googleusercontent.com</string>
</resources>
